# KreaitX Production & Deployment Environment Variables
# NEVER commit .env files or secret keys to git. Configure these in the Vercel Dashboard.

# Canonical Production URL (Used for sitemap, canonicals, metadataBase)
# For Vercel preview: https://kreait-x-by-faiza.vercel.app
# For custom domain: https://kreaitx.com
NEXT_PUBLIC_SITE_URL=https://kreaitx.com

# Google Analytics 4 Measurement ID (Optional, e.g., G-XXXXXXXXXX)
# If left empty, tracking scripts are not loaded
NEXT_PUBLIC_GA_ID=

# Resend API Key for automated contact form delivery (Optional, server-only secret)
# If left empty, contact submissions will still succeed and log to stdout
RESEND_API_KEY=

# Primary destination inbox for new project inquiries (Server-only)
CONTACT_TO_EMAIL=contact@kreaitx.com

